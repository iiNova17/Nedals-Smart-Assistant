# Copy to .env. Never commit secrets. Phase 1 requires Python 3.12+.
PLUME_DATABASE_PATH=data/plume.sqlite3
PLUME_GEMINI_API_KEY=
# Start with the Gemini free tier; billing is not required for basic chat.
PLUME_GEMINI_MODEL=gemini-3.5-flash
PLUME_MAX_OUTPUT_TOKENS=2048
PLUME_PROVIDER_TIMEOUT_SECONDS=120
PLUME_CONTEXT_TURNS=20
PLUME_CONTEXT_DAYS=7
PLUME_CONTEXT_CHARACTERS=24000
# These are request caps, not a dollar-denominated billing cap.
PLUME_DAILY_TEAM_REQUESTS=200
PLUME_DAILY_USER_REQUESTS=40
PLUME_LOG_LEVEL=INFO
# Kept as PLUME_* for compatibility with existing installations and saved keys.
# app.setup generates the bridge token locally. Do not put it in source control.
PLUME_BRIDGE_TOKEN=
PLUME_TEAM_CONFIG_PATH=data/team.json
PLUME_BACKEND_URL=http://127.0.0.1:8000
PLUME_DRIVE_TOKEN_PATH=secrets/google-drive-token.json
PLUME_INCOMING_PATH=data/incoming
PLUME_MAX_UPLOAD_BYTES=26214400
# Managed PDF index; originals remain in Drive. Background sync every two minutes.
PLUME_DOCUMENT_SEARCH_ENABLED=true
PLUME_DOCUMENT_SYNC_SECONDS=120
PLUME_DOCUMENT_MAX_FILES=20
PLUME_DOCUMENT_MAX_TOTAL_BYTES=209715200
PLUME_DOCUMENT_MODEL=gemini-3.5-flash-lite

# Editable identity and project background; live status and permissions live in SQLite.
PLUME_CONTEXT_PATH=context/local
PLUME_CALENDAR_TOKEN_PATH=secrets/google-calendar-token.json
PLUME_DEFAULT_TIMEZONE=Africa/Cairo
# No-key search keeps this installation free. Gemini grounding is optional, not assumed free.
PLUME_SEARCH_PROVIDER=ddgs
PLUME_SEARCH_MODEL=gemini-2.5-flash
PLUME_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
